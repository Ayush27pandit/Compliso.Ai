# Compliso.ai — Environment Variables
# Copy to .env and fill in your values

# ── LLM (Groq) ─────────────────────────────────────────
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_API_KEY=                  # optional, for failover

# ── Vector Database (Qdrant Cloud) ─────────────────────
QDRANT_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
QDRANT_CLUSTER_ENDPOINT=https://xxxxx.cloud.qdrant.io:6333
QDRANT_COLLECTION_NAME=compliso_chunks

# ── Embeddings (Google Gemini) ─────────────────────────
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxx

# ── Observability (Pydantic Logfire) ───────────────────
LOGFIRE_API_KEY=pylf_xxxxxxxxxxxxxxxxxxxx

# ── Guardrails ─────────────────────────────────────────
ENABLE_GUARDRAILS=true                  # true | false
